{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "vite/client", "fvtt-types"]
  },
  "include": ["modules/**/*", "scripts/**/*", "tests/**/*", "types/**/*"],
  "exclude": ["node_modules", "lib", "dist", "build"]
}
